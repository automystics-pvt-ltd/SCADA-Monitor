# Required — fill these in before deploying. Compose will reject blank values.
DATABASE_URL=
SESSION_SECRET=
PUBLIC_DOMAIN=sms.automystics.tech

# Required for live plant telemetry on Ubuntu
MQTT_BROKER_URL=
MQTT_TOPIC=
MQTT_PLANT_SITE=
MQTT_CLIENT_ID=solar-scada
MQTT_CLIENT_INSTANCE_ID=primary
# Leave MQTT credentials blank only if the broker permits anonymous access.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PLANT_TIMEZONE=Asia/Kolkata
PLANT_TIMEZONE=Asia/Kolkata

# Required for the Platform Admin sign-in methods shown in the app.
# Use an email already provisioned and active in the Platform Admin database.
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_GOOGLE_CLIENT_ID=
PLATFORM_ADMIN_GOOGLE_CLIENT_SECRET=
# Gmail SMTP account and app password for one-time-code sign-in.
PLATFORM_ADMIN_SMTP_USERNAME=
PLATFORM_ADMIN_SMTP_PASSWORD=

# Optional controls
LOG_LEVEL=info
SCADA_ALLOW_GLOBAL_ACCESS=false
SCADA_LOCATION_ADMIN_ACCESS=false
ISSUER_URL=
REPL_ID=