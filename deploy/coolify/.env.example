# Required
DATABASE_URL=postgresql://user:password@postgres-host:5432/solar_scada
SESSION_SECRET=replace-with-a-long-random-value

# MQTT broker
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_TOPIC=plant/modbus
MQTT_CLIENT_ID=solar-scada-coolify
MQTT_CLIENT_INSTANCE_ID=primary
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PLANT_SITE=
MQTT_PLANT_TIMEZONE=Asia/Kolkata
PLANT_TIMEZONE=Asia/Kolkata

# Platform Admin authentication
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_GOOGLE_CLIENT_ID=
PLATFORM_ADMIN_GOOGLE_CLIENT_SECRET=
PLATFORM_ADMIN_SMTP_USERNAME=
PLATFORM_ADMIN_SMTP_PASSWORD=

# Optional controls
LOG_LEVEL=info
SCADA_ALLOW_GLOBAL_ACCESS=false
SCADA_LOCATION_ADMIN_ACCESS=false
ISSUER_URL=
REPL_ID=