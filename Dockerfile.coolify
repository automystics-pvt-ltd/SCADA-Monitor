# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22
ARG PNPM_VERSION=10.26.1

FROM caddy:2.10-alpine AS gateway
COPY deploy/coolify/Caddyfile /etc/caddy/Caddyfile

FROM node:${NODE_VERSION}-bookworm-slim AS workspace
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

COPY . .
RUN pnpm install --frozen-lockfile

FROM workspace AS api-build
RUN pnpm --filter @workspace/api-server run build

FROM node:${NODE_VERSION}-bookworm-slim AS api
ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /app

COPY --from=workspace /workspace/node_modules ./node_modules
COPY --from=workspace /workspace/artifacts/api-server/node_modules ./artifacts/api-server/node_modules
COPY --from=api-build /workspace/artifacts/api-server/dist ./artifacts/api-server/dist

USER node
EXPOSE 8080
CMD ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]

FROM workspace AS scada-build
ENV NODE_ENV=production
ENV PORT=3000
ENV BASE_PATH=/
RUN pnpm --filter @workspace/mqtt-scada-monitor run build

FROM nginx:1.27-alpine AS scada
COPY deploy/coolify/static-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=scada-build /workspace/artifacts/mqtt-scada-monitor/dist/public /usr/share/nginx/html
EXPOSE 80

FROM workspace AS admin-build
ENV NODE_ENV=production
ENV PORT=3000
ENV BASE_PATH=/platform-admin/
RUN pnpm --filter @workspace/platform-admin run build

FROM nginx:1.27-alpine AS admin
COPY deploy/coolify/static-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-build /workspace/artifacts/platform-admin/dist/public /usr/share/nginx/html
EXPOSE 80